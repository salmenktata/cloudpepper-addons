<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_quelyos_dynamic_picking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.quelyos.dynamic.picking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <!-- Ancrage robuste sur <form> -->
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Quelyos – Dynamic Picking" data-key="quelyos_dynamic_picking">
                    <h2>Quelyos – Dynamic Picking</h2>
                    <div class="row mt16 o_settings_container">

                        <!-- Activation + eCom -->
                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="quelyos_dynamic_enabled"/></div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_enabled"/>
                                <div class="text-muted">Active la stratégie de sélection dynamique pour les livraisons sortantes.</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="quelyos_dynamic_ecom_only"/></div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_ecom_only"/>
                                <div class="text-muted">Appliquer uniquement aux commandes eCommerce (SO avec un site web).</div>
                            </div>
                        </div>

                        <!-- Base de stock -->
                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="quelyos_dynamic_stock_basis"/></div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_stock_basis"/>
                                <div class="text-muted">Choisissez la base de stock (Libre, On-Hand, Prévisionnel).</div>
                            </div>
                        </div>

                        <!-- Central + Boutiques -->
                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="quelyos_dynamic_central_location_id" options="{'no_open': True}"/></div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_central_location_id"/>
                                <div class="text-muted">Sélectionnez l'emplacement central.</div>
                            </div>
                        </div>

                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"><field name="quelyos_dynamic_shop_ids" widget="many2many_tags" options="{'no_open': True}"/></div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_shop_ids"/>
                                <div class="text-muted">Boutiques considérées par la stratégie.</div>
                            </div>
                        </div>

                        <!-- Ordre strict -->
                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="quelyos_dynamic_strict_order_enabled"/></div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_strict_order_enabled"/>
                                <div class="text-muted">Si activé : on prend la première boutique de la liste qui couvre toute la commande.</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="quelyos_dynamic_strict_shop_order" placeholder="Gafsa>Sousse>Soukra"/></div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_strict_shop_order"/>
                                <div class="text-muted">Ordre strict des boutiques séparées par &quot;&gt;&quot;.</div>
                            </div>
                        </div>

                        <!-- Réassort : auto-confirm & auto-validate -->
                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="quelyos_dynamic_auto_confirm_replenishment"/></div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_auto_confirm_replenishment"/>
                                <div class="text-muted">Confirme et tente de réserver automatiquement le réassort interne créé.</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="quelyos_dynamic_auto_validate_replenishment"/></div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_auto_validate_replenishment"/>
                                <div class="text-muted">Valide automatiquement le réassort si toutes les lignes sont entièrement réservées.</div>
                            </div>
                        </div>

                        <!-- ✅ NOUVEAU : Log de succès optionnel -->
                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="quelyos_dynamic_log_success"/></div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_log_success"/>
                                <div class="text-muted">
                                    Afficher un message de succès (“Source retenue = …”) dans le chatter des livraisons.
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
