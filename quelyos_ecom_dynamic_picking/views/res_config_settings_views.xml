<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quelyos – Dynamic Picking: réglages Sales -->
    <record id="res_config_settings_view_form_inherit_quelyos_dynamic_picking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.quelyos.dynamic.picking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Quelyos – Dynamic Picking" data-key="quelyos_dynamic_picking">
                    <h2>Quelyos – Dynamic Picking</h2>
                    <div class="row mt16">

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="quelyos_dynamic_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_enabled"/>
                                <div class="text-muted">
                                    Active la stratégie de sélection dynamique pour les livraisons sortantes.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="quelyos_dynamic_ecom_only"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_ecom_only"/>
                                <div class="text-muted">
                                    Limiter l'application aux livraisons issues du site eCommerce.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="quelyos_dynamic_stock_basis"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_stock_basis"/>
                                <div class="text-muted">
                                    Base de stock utilisée pour évaluer la capacité (libre / physique / prévisionnel).
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="quelyos_dynamic_central_location_id" options="{'no_create': True}"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_central_location_id"/>
                                <div class="text-muted">
                                    Emplacement central à prioriser si capable de couvrir 100% d'une ligne.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="quelyos_dynamic_shop_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_shop_ids"/>
                                <div class="text-muted">
                                    Boutiques (emplacements) à considérer comme sources.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="quelyos_dynamic_strict_order_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_strict_order_enabled"/>
                                <div class="text-muted">
                                    Imposer un ordre strict de priorité des boutiques.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box" attrs="{'invisible':[('quelyos_dynamic_strict_order_enabled','=',False)]}">
                            <div class="o_setting_left_pane">
                                <field name="quelyos_dynamic_strict_shop_order" placeholder="Gafsa>Sousse>Soukra"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_strict_shop_order"/>
                                <div class="text-muted">
                                    Ordre imposé (séparateur &quot;&gt;&quot;). Correspond aux noms d'affichage des emplacements.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="quelyos_dynamic_auto_confirm_replenishment"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_auto_confirm_replenishment"/>
                                <div class="text-muted">
                                    Confirmer et tenter la réservation automatique du réassort interne créé.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="quelyos_dynamic_auto_validate_replenishment"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_auto_validate_replenishment"/>
                                <div class="text-muted">
                                    Valider automatiquement le réassort si 100% réservé.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="quelyos_dynamic_log_success"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="quelyos_dynamic_log_success"/>
                                <div class="text-muted">
                                    Afficher un message de succès (“Source retenue = …”) dans le chatter des livraisons.
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
