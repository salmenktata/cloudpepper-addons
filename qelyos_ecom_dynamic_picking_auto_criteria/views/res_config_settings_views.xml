<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_res_config_settings_ecom_dynamic_criteria" model="ir.ui.view">
    <field name="name">res.config.settings.ecom.dynamic.criteria.view</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form[contains(@class, 'oe_form_configuration') or @js_class='base_settings']" position="inside">
        <div class="app_settings_block">
          <h2>eCommerce – CENTRAL &gt; Max stock (Gafsa/Sousse/Tunis) &gt; Ordre fixe</h2>
          <div class="row mt16 o_settings_container">
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <span class="fa fa-truck"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="ecom_dynamic_source_location_ids"/>
                <div class="text-muted">Emplacements sources possibles (inclure CENTRAL, Gafsa, Sousse, Tunis)</div>
                <div class="content-group">
                  <field name="ecom_dynamic_source_location_ids" widget="many2many_tags"/>
                </div>
              </div>
            </div>
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <span class="fa fa-random"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="ecom_dynamic_strategy"/>
                <div class="text-muted">Stratégie de sélection</div>
                <div class="content-group">
                  <field name="ecom_dynamic_strategy"/>
                </div>
              </div>
            </div>
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <span class="fa fa-globe"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="ecom_dynamic_website_id"/>
                <div class="text-muted">(Optionnel) Limiter à un site web</div>
                <div class="content-group">
                  <field name="ecom_dynamic_website_id" options="{'no_open': True}"/>
                </div>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
