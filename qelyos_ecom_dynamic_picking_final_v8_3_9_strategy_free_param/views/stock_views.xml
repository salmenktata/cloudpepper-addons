<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_picking_form_qelyos_log" model="ir.ui.view">
    <field name="name">stock.picking.form.qelyos.log</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Qelyos Log">
          <field name="qelyos_log" readonly="1" nolabel="1"/>
        </page>
      </xpath>
    </field>
  </record>
</odoo>