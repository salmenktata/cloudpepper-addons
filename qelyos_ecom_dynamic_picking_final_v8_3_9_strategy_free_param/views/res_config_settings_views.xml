<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Standalone form view for our settings block to avoid xpath issues -->
  <record id="view_qelyos_res_config_settings_form" model="ir.ui.view">
    <field name="name">qelyos.res.config.settings.form</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="100"/>
    <field name="arch" type="xml">
      <form string="Qelyos – eCommerce Dynamic Picking">
        <sheet>
          <group string="Général">
            <field name="ecom_dynamic_only_website"/>
            <field name="ecom_strict_order"/>
            <field name="ecom_dual_log"/>
          </group>
          <group string="Flux">
            <field name="ecom_in_steps"/>
            <field name="ecom_out_steps"/>
            <button name="action_apply_steps_to_all_warehouses" type="object" class="oe_highlight" string="Appliquer à tous les entrepôts"/>
          </group>
          <group string="Emplacements source (OUT)">
            <field name="ecom_dynamic_source_location_ids" widget="many2many_tags" context="{'default_usage':'internal'}"/>
          </group>
          <separator string="Notes"/>
          <label string="- IN/OUT en 1/2/3 étapes via le bouton ci-dessus."/>
          <label string="- Ordre strict bloque la validation si une opération précédente liée n'est pas terminée."/>
          <label string="- Dual-log ajoute un log dans le chatter et le champ Qelyos Log du picking."/>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
