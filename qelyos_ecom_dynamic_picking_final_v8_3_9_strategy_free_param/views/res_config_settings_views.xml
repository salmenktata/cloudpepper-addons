<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_qelyos_settings_form" model="ir.ui.view">
    <field name="name">qelyos.dynamic.picking.settings.form</field>
    <field name="model">res.config.settings</field>
    <field name="arch" type="xml">
      <form string="Qelyos – eCommerce Dynamic Picking">
        <sheet>
          <group string="Options générales">
            <field name="ecom_dynamic_only_website"/>
            <field name="ecom_strict_order"/>
            <field name="ecom_dual_log"/>
          </group>
          <group string="Flux IN / OUT">
            <field name="ecom_in_steps"/>
            <field name="ecom_out_steps"/>
            <button name="action_apply_steps_to_all_warehouses"
                    type="object"
                    class="oe_highlight"
                    string="Appliquer à tous les entrepôts"/>
          </group>
          <group string="Emplacements">
            <field name="ecom_dynamic_source_location_ids" widget="many2many_tags" context="{'default_usage':'internal'}"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
