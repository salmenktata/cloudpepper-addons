<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_res_config_settings_qelyos_dynamic_picking" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.qelyos.dynamic.picking</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('settings')]" position="inside">
        <div class="app_settings_block" data-string="Qelyos – Dynamic Picking" string="Qelyos – Dynamic Picking">
          <h2>Qelyos – eCommerce Dynamic Picking</h2>
          <group>
            <field name="ecom_dynamic_only_website"/>
            <field name="ecom_strict_order"/>
            <field name="ecom_dual_log"/>
          </group>
          <group>
            <field name="ecom_in_steps"/>
            <field name="ecom_out_steps"/>
            <button name="action_apply_steps_to_all_warehouses"
                    type="object"
                    class="oe_highlight"
                    string="Appliquer maintenant à tous les entrepôts"/>
          </group>
          <group>
            <field name="ecom_dynamic_source_location_ids" widget="many2many_tags"
                   context="{'default_usage': 'internal'}"/>
          </group>
          <label string="Notes" colspan="2"/>
          <p class="text-muted" colspan="2">
            - IN/OUT dynamiques en 1/2/3 étapes appliqués globalement via le bouton ci-dessus, sans modifier vos routes.<br/>
            - Ordre strict: bloque la validation tant que les opérations précédentes ne sont pas terminées.<br/>
            - Dual-log: enregistre un log additionnel dans le chatter + champ local sur les picking.
          </p>
        </div>
      </xpath>
    </field>
  </record>
</odoo>