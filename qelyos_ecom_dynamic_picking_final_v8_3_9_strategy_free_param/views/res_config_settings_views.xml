<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_res_config_settings_qelyos_dynamic_picking" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.qelyos.dynamic.picking</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[contains(@class,'o_settings_container')]" position="inside">
        <div class="app_settings_block" string="Qelyos – Dynamic Picking">
          <h2>Qelyos – eCommerce Dynamic Picking</h2>
          <div class="row mt16">
            <div class="col-12 col-lg-6">
              <div class="o_setting_box">
                <div class="o_setting_left_pane">
                  <field name="ecom_dynamic_only_website"/>
                </div>
                <div class="o_setting_right_pane">
                  <label for="ecom_dynamic_only_website"/>
                  <div class="text-muted">Limiter aux commandes eCommerce.</div>
                </div>
              </div>

              <div class="o_setting_box">
                <div class="o_setting_left_pane">
                  <field name="ecom_strict_order"/>
                </div>
                <div class="o_setting_right_pane">
                  <label for="ecom_strict_order"/>
                  <div class="text-muted">Bloque la validation si une opération précédente liée n'est pas terminée.</div>
                </div>
              </div>

              <div class="o_setting_box">
                <div class="o_setting_left_pane">
                  <field name="ecom_dual_log"/>
                </div>
                <div class="o_setting_right_pane">
                  <label for="ecom_dual_log"/>
                  <div class="text-muted">Journalisation additionnelle (chatter + champ).</div>
                </div>
              </div>
            </div>

            <div class="col-12 col-lg-6">
              <div class="o_setting_box">
                <div class="o_setting_left_pane">
                  <field name="ecom_in_steps"/>
                </div>
                <div class="o_setting_right_pane">
                  <label for="ecom_in_steps"/>
                  <div class="text-muted">Configurer les réceptions en 1/2/3 étapes.</div>
                  <button name="action_apply_steps_to_all_warehouses" type="object" class="btn btn-primary mt8">
                    Appliquer à tous les entrepôts
                  </button>
                </div>
              </div>

              <div class="o_setting_box">
                <div class="o_setting_left_pane">
                  <field name="ecom_out_steps"/>
                </div>
                <div class="o_setting_right_pane">
                  <label for="ecom_out_steps"/>
                  <div class="text-muted">Configurer les livraisons en 1/2/3 étapes.</div>
                </div>
              </div>

              <div class="o_setting_box">
                <div class="o_setting_left_pane">
                  <field name="ecom_dynamic_source_location_ids" widget="many2many_tags" context="{'default_usage': 'internal'}"/>
                </div>
                <div class="o_setting_right_pane">
                  <label for="ecom_dynamic_source_location_ids"/>
                  <div class="text-muted">Emplacements source autorisés pour les pickings OUT.</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
