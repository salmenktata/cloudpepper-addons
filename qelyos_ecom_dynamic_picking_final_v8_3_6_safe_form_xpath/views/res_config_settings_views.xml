<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_res_config_settings_qelyos_dynamic_opt_v836" model="ir.ui.view">
    <field name="name">res.config.settings.qelyos.dynamic.opt.v836</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form[1]" position="inside">
        <div class="app_settings_block" data-string="Qelyos Dynamic Picking" string="Qelyos Dynamic Picking">
          <h2>Qelyos Dynamic Picking (v8.3.6 — SAFE)</h2>
          <div class="row mt16 o_settings_container">
            <div class="col-12 col-lg-6">
              <div class="o_setting_box">
                <div class="o_setting_left_pane"><field name="ecom_dynamic_enabled"/></div>
                <div class="o_setting_right_pane"><label for="ecom_dynamic_enabled"/><div class="text-muted">Activate Qelyos dynamic picking and related options.</div></div>
              </div>
              <div class="o_setting_box" invisible="not ecom_dynamic_enabled">
                <div class="o_setting_left_pane"><field name="ecom_dynamic_only_website"/></div>
                <div class="o_setting_right_pane"><label for="ecom_dynamic_only_website"/><div class="text-muted">Apply rules only for website orders (website_sale).</div></div>
              </div>
              <div class="o_setting_box" invisible="not ecom_dynamic_enabled">
                <div class="o_setting_left_pane"><field name="ecom_dynamic_strict_order"/></div>
                <div class="o_setting_right_pane"><label for="ecom_dynamic_strict_order"/><div class="text-muted">Enforce strict move sequence within pickings.</div></div>
              </div>
              <div class="o_setting_box" invisible="not ecom_dynamic_enabled">
                <div class="o_setting_left_pane"><field name="ecom_dynamic_dual_log"/></div>
                <div class="o_setting_right_pane"><label for="ecom_dynamic_dual_log"/><div class="text-muted">Post detailed chatter logs on reservation/validation.</div></div>
              </div>
            </div>
            <div class="col-12 col-lg-6" invisible="not ecom_dynamic_enabled">
              <div class="o_setting_box">
                <div class="o_setting_left_pane"><field name="ecom_dynamic_pick_steps"/></div>
                <div class="o_setting_right_pane"><label for="ecom_dynamic_pick_steps"/><div class="text-muted">Target steps for internal picking (1/2/3).</div></div>
              </div>
              <div class="o_setting_box">
                <div class="o_setting_left_pane"><field name="ecom_dynamic_out_steps"/></div>
                <div class="o_setting_right_pane"><label for="ecom_dynamic_out_steps"/><div class="text-muted">Target steps for outgoing deliveries (1/2/3).</div></div>
              </div>
              <div class="o_setting_box">
                <div class="o_setting_left_pane"><field name="ecom_dynamic_strategy"/></div>
                <div class="o_setting_right_pane"><label for="ecom_dynamic_strategy"/><div class="text-muted">High-level hint for dynamic behavior (independent of routes).</div></div>
              </div>
              <div class="o_setting_box">
                <div class="o_setting_left_pane"><field name="ecom_dynamic_source_location_ids" widget="many2many_tags" options="{'no_create_edit': True}"/></div>
                <div class="o_setting_right_pane"><label for="ecom_dynamic_source_location_ids"/><div class="text-muted">Preferred source locations for guidance (optional).</div></div>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
