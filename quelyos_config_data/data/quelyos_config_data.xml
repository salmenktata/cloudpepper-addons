<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Utiliser l'entrepôt par défaut d'Odoo et le configurer comme entrepôt central -->
    <record id="stock.warehouse0" model="stock.warehouse">
        <field name="name">Entrepôt CENTRAL</field>
        <field name="code">CENT</field>
    </record>

    <!-- Assurez-vous que l'emplacement de stock par défaut s'appelle bien 'CENT/Stock' -->
    <record id="stock.stock_location_stock" model="stock.location">
        <field name="name">CENT/Stock</field>
    </record>

    <!-- Création des emplacements des boutiques -->
    <record id="location_boutique_gafsa" model="stock.location">
        <field name="name">Boutique Gafsa</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
    </record>

    <record id="location_boutique_sousse" model="stock.location">
        <field name="name">Boutique Sousse</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
    </record>

    <record id="location_boutique_soukra" model="stock.location">
        <field name="name">Boutique Soukra</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
    </record>

    <!-- Création des types d'opérations de réassort -->
    <record id="picking_type_reassort_gafsa" model="stock.picking.type">
        <field name="name">Réassort vers Gafsa</field>
        <field name="code">internal</field>
        <field name="sequence_code">REASSORT-TO-GAFSA</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="default_location_src_id" ref="stock.stock_location_stock"/>
        <field name="default_location_dest_id" ref="location_boutique_gafsa"/>
    </record>

    <record id="picking_type_reassort_sousse" model="stock.picking.type">
        <field name="name">Réassort vers Sousse</field>
        <field name="code">internal</field>
        <field name="sequence_code">REASSORT-TO-SOUSSE</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="default_location_src_id" ref="stock.stock_location_stock"/>
        <field name="default_location_dest_id" ref="location_boutique_sousse"/>
    </record>
    
    <record id="picking_type_reassort_soukra" model="stock.picking.type">
        <field name="name">Réassort vers Soukra</field>
        <field name="code">internal</field>
        <field name="sequence_code">REASSORT-TO-SOUKRA</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="default_location_src_id" ref="stock.stock_location_stock"/>
        <field name="default_location_dest_id" ref="location_boutique_soukra"/>
    </record>
    
    <!-- Création des types d'opérations de livraison web -->
    <record id="picking_type_expedition_web_gafsa" model="stock.picking.type">
        <field name="name">Expédition Web - Gafsa</field>
        <field name="code">outgoing</field>
        <field name="sequence_code">EXP-WEB-GAFSA</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="default_location_src_id" ref="location_boutique_gafsa"/>
        <field name="default_location_dest_id" ref="stock.stock_location_customers"/>
    </record>

    <record id="picking_type_expedition_web_sousse" model="stock.picking.type">
        <field name="name">Expédition Web - Sousse</field>
        <field name="code">outgoing</field>
        <field name="sequence_code">EXP-WEB-SOUSSE</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="default_location_src_id" ref="location_boutique_sousse"/>
        <field name="default_location_dest_id" ref="stock.stock_location_customers"/>
    </record>
    
    <record id="picking_type_expedition_web_soukra" model="stock.picking.type">
        <field name="name">Expédition Web - Soukra</field>
        <field name="code">outgoing</field>
        <field name="sequence_code">EXP-WEB-SOUKRA</field>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="default_location_src_id" ref="location_boutique_soukra"/>
        <field name="default_location_dest_id" ref="stock.stock_location_customers"/>
    </record>

    <!-- Création des journaux de caisse pour chaque PoS -->
    <record id="pos_cash_journal_soukra" model="account.journal">
        <field name="name">PoS Cash - Soukra</field>
        <field name="code">POSCS</field>
        <field name="type">cash</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    
    <record id="pos_cash_journal_sousse" model="account.journal">
        <field name="name">PoS Cash - Sousse</field>
        <field name="code">POSSS</field>
        <field name="type">cash</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    
    <record id="pos_cash_journal_gafsa" model="account.journal">
        <field name="name">PoS Cash - Gafsa</field>
        <field name="code">POSG</field>
        <field name="type">cash</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <!-- Création des configurations de Point de Vente (PoS) -->
    <record id="pos_config_soukra" model="pos.config">
        <field name="name">Boutique Soukra</field>
        <field name="picking_type_id" ref="picking_type_expedition_web_soukra"/>
        <field name="journal_id" ref="pos_cash_journal_soukra"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="iface_cashdrawer">True</field>
        <field name="iface_electronic_scale">True</field>
        <field name="module_pos_hr">True</field>
    </record>

    <record id="pos_config_sousse" model="pos.config">
        <field name="name">Boutique Sousse</field>
        <field name="picking_type_id" ref="picking_type_expedition_web_sousse"/>
        <field name="journal_id" ref="pos_cash_journal_sousse"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="iface_cashdrawer">True</field>
        <field name="iface_electronic_scale">True</field>
        <field name="module_pos_hr">True</field>
    </record>

    <record id="pos_config_gafsa" model="pos.config">
        <field name="name">Boutique Gafsa</field>
        <field name="picking_type_id" ref="picking_type_expedition_web_gafsa"/>
        <field name="journal_id" ref="pos_cash_journal_gafsa"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="iface_cashdrawer">True</field>
        <field name="iface_electronic_scale">True</field>
        <field name="module_pos_hr">True</field>
    </record>
</odoo>
