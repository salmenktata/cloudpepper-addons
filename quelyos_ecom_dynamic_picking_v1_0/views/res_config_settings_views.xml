<?xml version="1.0" encoding="utf-8"?>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quelyos_dynamic_picking_sales_settings" model="ir.ui.view">
        <field name="name">quelyos.dynamic.picking.sales.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- On insère juste après l’option "delivery" -->
            <xpath expr="//setting[@id='delivery']" position="after">
                <setting id="quelyos_dynamic_picking"
                         string="Quelyos – Dynamic Picking"
                         help="Active et configure le picking dynamique pour les ventes eCommerce.">
                    <field name="quelyos_dynamic_strategy"/>
                    <field name="quelyos_dynamic_source_location_ids" widget="many2many_tags"/>
                    <field name="quelyos_dynamic_only_website"/>
                </setting>
            </xpath>

        </field>
    </record>
</odoo>


