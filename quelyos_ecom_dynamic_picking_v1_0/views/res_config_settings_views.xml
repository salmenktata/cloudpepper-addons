<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_quelyos_dynamic_picking_sales_settings" model="ir.ui.view">
    <field name="name">quelyos.dynamic.picking.sales.settings</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
    <field name="arch" type="xml">

      <!-- On insère notre bloc juste après l’option "delivery" existante -->
      <xpath expr="//setting[@id='delivery']" position="after">
        <setting id="quelyos_dynamic_picking"
                 string="Qelyos – Picking dynamique"
                 help="Active la sélection automatique de l’emplacement source pour les livraisons sortantes, avec réassort interne si nécessaire.">

          <!-- Stratégie appliquée -->
          <div class="o_form_label">
            Stratégie appliquée
          </div>
          <div class="content-group">
            <field name="quelyos_dynamic_strategy"/>
            <div class="text-muted">
              exp : « Critères personnalisés » vérifie d’abord CENT/Stock, sinon choisit la meilleure boutique, puis peut déclencher un réassort.
            </div>
          </div>

          <!-- Type de stock utilisé -->
          <div class="o_form_label mt16">
            Type de stock utilisé
          </div>
          <div class="content-group">
            <field name="quelyos_dynamic_stock_basis"/>
            <div class="text-muted">
              exp : Quantité libre = stock physique − réservations ; Prévisionnel = inclut les entrées à venir.
            </div>
          </div>

          <!-- Appliquer uniquement eCommerce -->
          <div class="o_form_label mt16">
            Portée
          </div>
          <div class="content-group">
            <field name="quelyos_dynamic_only_website"/>
            <div class="text-muted">
              exp : si coché, la stratégie ne s’applique qu’aux commandes passées sur le site web.
            </div>
          </div>

          <!-- Emplacement central -->
          <div class="o_form_label mt16">
            Emplacement central (CENT/Stock)
          </div>
          <div class="content-group">
            <field name="quelyos_dynamic_central_location_id" options="{'no_create_edit': False}"/>
            <div class="text-muted">
              exp : choisissez l’emplacement central prioritaire si son stock couvre toute la commande.
            </div>
          </div>

          <!-- Boutiques à considérer -->
          <div class="o_form_label mt16">
            Boutiques à considérer
          </div>
          <div class="content-group">
            <field name="quelyos_dynamic_shop_ids" widget="many2many_tags"/>
            <div class="text-muted">
              exp : ex : Gafsa/Stock, Sousse/Stock, Soukra/Stock. Le calcul ne prend en compte que ces emplacements.
            </div>
          </div>

          <!-- Ordre strict -->
          <div class="o_form_label mt16">
            Ordre strict des boutiques
          </div>
          <div class="content-group">
            <field name="quelyos_dynamic_strict_order_enabled"/>
            <field name="quelyos_dynamic_shop_order_names" placeholder="ex : Gafsa, Sousse, Soukra" class="ms-2"/>
            <div class="text-muted">
              exp : si activé, test dans l’ordre saisi et choisit la première boutique couvrant toute la commande.
            </div>
          </div>

        </setting>
      </xpath>

    </field>
  </record>
</odoo>
