<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_quelyos_dynamic_picking_sales_settings" model="ir.ui.view">
    <field name="name">quelyos.dynamic.picking.sales.settings</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
    <field name="arch" type="xml">

      <!-- Insertion juste après l’option "delivery" (Onglet Vente > Expédition) -->
      <xpath expr="//setting[@id='delivery']" position="after">
        <setting id="quelyos_dynamic_picking"
                 string="Quelyos – Picking dynamique"
                 help="Active la sélection automatique de l’emplacement source pour les livraisons sortantes, avec réassort interne si nécessaire.">

          <!-- Stratégie appliquée -->
          <div class="o_form_label">Stratégie appliquée</div>
          <div class="content-group">
            <field name="quelyos_dynamic_strategy"/>
            <div class="text-muted">
              exp : « Personnalisée » applique : (1) CENT/Stock si tout est couvert, sinon (2) meilleur stock disponible, sinon (3) meilleur On‑Hand, sinon (4) magasin avec le plus d’articles de la commande (puis réassort).
            </div>
          </div>

          <!-- Base de calcul du stock -->
          <div class="o_form_label mt16">Base de calcul du stock</div>
          <div class="content-group">
            <field name="quelyos_dynamic_stock_basis"/>
            <div class="text-muted">
              exp : Quantité libre = physique − réservé ; Prévisionnel = inclut les entrées confirmées.
            </div>
          </div>

          <!-- Portée eCommerce -->
          <div class="o_form_label mt16">Portée</div>
          <div class="content-group">
            <field name="quelyos_dynamic_only_website"/>
            <div class="text-muted">
              exp : si coché, la stratégie s’applique uniquement aux commandes issues du site web.
            </div>
          </div>

          <!-- Emplacement central -->
          <div class="o_form_label mt16">Emplacement central (CENT/Stock)</div>
          <div class="content-group">
            <field name="quelyos_dynamic_central_location_id" options="{'no_create': True}"/>
            <div class="text-muted">
              exp : sélectionnez l’emplacement central privilégié pour le Critère 1.
            </div>
          </div>

        </setting>
      </xpath>

    </field>
  </record>
</odoo>
