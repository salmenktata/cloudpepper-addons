<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_quelyos_dynamic_picking_sales_settings" model="ir.ui.view">
    <field name="name">quelyos.dynamic.picking.sales.settings</field>
    <field name="model">res.config.settings</field>
    <!-- ⚠️ On hérite de la vue de configuration Ventes -->
    <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
    <field name="arch" type="xml">

      <!-- ✅ On s’insère DANS le bloc Shipping existant -->
      <xpath expr="//block[@name='sale_shipping_setting_container']" position="inside">
        <setting id="quelyos_dynamic_picking"
                 string="Quelyos – Picking dynamique"
                 help="Active la sélection automatique de l’emplacement source pour les livraisons sortantes, avec réassort interne si nécessaire.">

          <!-- Stratégie appliquée -->
          <div class="o_form_label">Stratégie appliquée</div>
          <div class="content-group">
            <field name="quelyos_dynamic_strategy"/>
            <div class="text-muted">
              exp : « Critères personnalisés » vérifie d’abord CENT/Stock, sinon choisit la meilleure boutique, puis déclenche un réassort si nécessaire.
            </div>
          </div>

          <!-- Type de stock -->
          <div class="o_form_label mt16">Type de stock utilisé</div>
          <div class="content-group">
            <field name="quelyos_dynamic_stock_basis"/>
            <div class="text-muted">
              exp : Quantité libre = stock physique − réservations ; Physique = stock réel ; Prévisionnel = inclut les entrées confirmées.
            </div>
          </div>

          <!-- Portée -->
          <div class="o_form_label mt16">Portée</div>
          <div class="content-group">
            <field name="quelyos_dynamic_only_website"/>
            <div class="text-muted">
              exp : si coché, la stratégie ne s’applique qu’aux commandes issues du site web.
            </div>
          </div>

          <!-- Emplacement central -->
          <div class="o_form_label mt16">Emplacement central (CENT/Stock)</div>
          <div class="content-group">
            <field name="quelyos_dynamic_central_location_id" options="{'no_open': True}"/>
            <div class="text-muted">
              exp : l’emplacement principal prioritaire si son stock couvre toute la commande.
            </div>
          </div>

          <!-- Boutiques (ordre = ordre d’ajout) -->
          <div class="o_form_label mt16">Boutiques à considérer (ordre = ordre d’ajout)</div>
          <div class="content-group">
            <field name="quelyos_dynamic_shop_ids"
                   widget="many2many_tags"
                   options="{'no_open': True}"
                   context="{'default_usage': 'internal'}"
                   placeholder="Sélectionnez les boutiques à inclure"/>
            <div class="text-muted">
              exp : l’ordre d’ajout sera utilisé comme <i>Critère 3</i> si le central est insuffisant et qu’aucune boutique ne couvre 100%.
            </div>
          </div>

        </setting>
      </xpath>
    </field>
  </record>
</odoo>
