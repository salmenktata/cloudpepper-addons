<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quelyos_dynamic_picking_sales_settings" model="ir.ui.view">
        <field name="name">quelyos.dynamic.picking.sales.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">

                <div class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="quelyos_strategy"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="quelyos_strategy"/>
                        <div class="text-muted">
                            Custom = sélection auto de la source selon la disponibilité.
                        </div>
                    </div>
                </div>

                <div class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="quelyos_stock_basis"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="quelyos_stock_basis"/>
                        <div class="text-muted">
                            Free / On-Hand / Forecast.
                        </div>
                    </div>
                </div>

                <div class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="quelyos_only_website"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="quelyos_only_website"/>
                        <div class="text-muted">
                            N’appliquer que pour eCommerce.
                        </div>
                    </div>
                </div>

                <div class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="quelyos_dual_log"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="quelyos_dual_log"/>
                        <div class="text-muted">
                            Log des événements dans le chatter.
                        </div>
                    </div>
                </div>

                <div class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="quelyos_central_location_id"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="quelyos_central_location_id"/>
                        <div class="text-muted">
                            Emplacement central (CENT/Stock).
                        </div>
                    </div>
                </div>

                <div class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="quelyos_source_location_ids" widget="many2many_tags"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="quelyos_source_location_ids"/>
                        <div class="text-muted">
                            Restriction des emplacements source (UI).
                        </div>
                    </div>
                </div>

                <div class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="quelyos_strict_order"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="quelyos_strict_order"/>
                        <div class="text-muted">
                            Tester les boutiques dans l’ordre défini.
                        </div>
                    </div>
                </div>

                <div class="o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="quelyos_store_order"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="quelyos_store_order"/>
                        <div class="text-muted">
                            Ex : Gafsa,Sousse,Soukra
                        </div>
                    </div>
                </div>

            </xpath>
        </field>
    </record>
</odoo>
