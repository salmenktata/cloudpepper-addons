<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quelyos_dynamic_picking_sales_settings" model="ir.ui.view">
        <field name="name">quelyos.dynamic.picking.sales.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='sale_shipping_setting_container']" position="inside">
                <setting id="quelyos_dynamic_picking" string="Quelyos – Dynamic Picking" help="Active la sélection dynamique d’emplacement source pour les livraisons sortantes.">
                    <field name="quelyos_dynamic_strategy"/>
                    <field name="quelyos_stock_basis"/>
                    <field name="quelyos_order_strict"/>
                    <field name="quelyos_dynamic_source_location_ids" widget="many2many_tags"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
