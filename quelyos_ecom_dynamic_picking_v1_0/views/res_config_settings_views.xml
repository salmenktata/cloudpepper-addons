<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulaire de configuration : Picking dynamique -->
    <record id="view_res_config_settings_quelyos_dynamic" model="ir.ui.view">
        <field name="name">res.config.settings.quelyos.dynamic.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.view_res_config_settings"/>
        <field name="arch" type="xml">

            <!-- On insère dans l'onglet Vente -->
            <xpath expr="//div[@id='sales']" position="inside">
                <div class="app_settings_block" data-string="Picking dynamique" string="Picking dynamique">
                    <h2>Picking dynamique – Paramétrage</h2>
                    <group>
                        <field name="quelyos_dynamic_enabled"/>
                        <field name="quelyos_dynamic_only_website"/>
                    </group>

                    <group string="Stratégie">
                        <field name="quelyos_dynamic_strategy"/>
                        <field name="quelyos_dynamic_stock_basis"/>
                        <field name="quelyos_dynamic_central_location_id"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="quelyos_dynamic_shop_ids"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_open': True}"
                               context="{'default_usage': 'internal'}"
                               placeholder="Sélectionnez les boutiques à inclure"/>
                    </group>

                    <p class="o_form_label_help">
                        <b>Critère 1 :</b> utiliser l’emplacement central si tout le stock est couvert.<br/>
                        <b>Critère 2 :</b> utiliser la boutique avec le plus de stock cumulé.<br/>
                        <b>Critère 3 :</b> utiliser les boutiques dans l’ordre indiqué ci-dessus.
                    </p>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
