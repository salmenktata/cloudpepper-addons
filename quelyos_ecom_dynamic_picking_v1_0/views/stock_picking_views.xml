<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Ajout d'un champ technique pour stocker le critère appliqué -->
    <record id="view_picking_form_quelyos" model="ir.ui.view">
        <field name="name">stock.picking.form.quelyos.strategy</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Ajout d'un onglet "Stratégie de sourcing" -->
            <notebook position="inside">
                <page string="Stratégie de sourcing">
                    <group>
                        <field name="quelyos_strategy_applied" readonly="1"/>
                        <field name="quelyos_reassort_picking_ids" readonly="1" widget="many2many_tags"/>
                    </group>
                </page>
            </notebook>

        </field>
    </record>
</odoo>
