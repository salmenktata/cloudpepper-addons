<odoo>
    <record id="view_res_config_settings_qelyos_strategy" model="ir.ui.view">
        <field name="name">res.config.settings.qelyos.strategy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" string="Qelyos Dynamic Picking">
                    <h2>Qelyos Dynamic Picking (v8.3.9)</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6">
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="ecom_dynamic_enabled"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="ecom_dynamic_enabled"/>
                                    <div class="text-muted">Enable Qelyos custom picking strategies</div>
                                </div>
                            </div>
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="ecom_dynamic_strategy"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="ecom_dynamic_strategy"/>
                                    <div class="text-muted">Choose strategy</div>
                                </div>
                            </div>
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="ecom_dynamic_free_stock_only"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="ecom_dynamic_free_stock_only"/>
                                    <div class="text-muted">Only use unreserved stock</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
