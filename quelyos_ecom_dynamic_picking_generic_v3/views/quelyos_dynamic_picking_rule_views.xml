<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vues -->
    <record id="quelyos_dynamic_picking_rule_view_tree" model="ir.ui.view">
        <field name="name">quelyos.dynamic.picking.rule.view.tree</field>
        <field name="model">quelyos.dynamic.picking.rule</field>
        <field name="arch" type="xml">
            <tree string="Règles de Picking Dynamique" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="product_category_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="quelyos_dynamic_picking_rule_view_form" model="ir.ui.view">
        <field name="name">quelyos.dynamic.picking.rule.view.form</field>
        <field name="model">quelyos.dynamic.picking.rule</field>
        <field name="arch" type="xml">
            <form string="Règle de Picking Dynamique">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-check">
                            <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;active&quot;}" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Nom de la règle..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="rule_type"/>
                            <field name="product_category_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration de la règle" name="rule_config">
                            <group>
                                <field name="central_location_id" attrs="{'invisible': [('rule_type', 'not in', ['central'])]}"/>
                                
                                <field name="shop_ids" widget="many2many_tags" attrs="{'invisible': [('rule_type', 'not in', ['best_coverage', 'strict_order', 'specific_shop'])]}"/>
                                <field name="shop_order_names" attrs="{'invisible': [('rule_type', '!=', 'strict_order')]}"/>
                                
                                <field name="stock_basis" attrs="{'invisible': [('rule_type', '=', 'central')]}"/>
                            </group>
                            <group string="Score pondéré" attrs="{'invisible': [('rule_type', '!=', 'best_coverage')]}">
                                <field name="weighted_score_enabled"/>
                                <field name="stock_coverage_weight" attrs="{'invisible': [('weighted_score_enabled', '=', False)]}"/>
                                <field name="stock_availability_weight" attrs="{'invisible': [('weighted_score_enabled', '=', False)]}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Kanban pour le drag-and-drop -->
    <record id="quelyos_dynamic_picking_rule_view_kanban" model="ir.ui.view">
        <field name="name">quelyos.dynamic.picking.rule.view.kanban</field>
        <field name="model">quelyos.dynamic.picking.rule</field>
        <field name="arch" type="xml">
            <kanban string="Règles de Picking Dynamique" class="o_kanban_ungrouped">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="product_category_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <h4 class="o_kanban_record_title">
                                    <a type="open"><field name="name"/></a>
                                </h4>
                                <ul>
                                    <li>Type: <field name="rule_type"/></li>
                                    <li t-if="record.product_category_id.raw_value">Catégorie: <field name="product_category_id"/></li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Action et Menu -->
    <record id="quelyos_dynamic_picking_rule_action" model="ir.actions.act_window">
        <field name="name">Règles de Picking Dynamique</field>
        <field name="res_model">quelyos.dynamic.picking.rule</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <menuitem id="quelyos_dynamic_picking_rules_menu"
              name="Règles de Picking Dynamique"
              parent="stock.menu_warehouse_config"
              action="quelyos_dynamic_picking_rule_action"
              sequence="100"/>
</odoo>
