<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quelyos_dynamic_picking_sales_settings" model="ir.ui.view">
        <field name="name">quelyos.dynamic.picking.sales.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='sale_shipping_setting_container']" position="inside">
                <setting id="quelyos_dynamic_picking" string="Quelyos – Dynamic Picking"
                         help="Configurez la stratégie de sélection de l'emplacement source via un système de règles."
                         invisible="context.get('module_sale_management')">
                    <div class="o_form_label">Stratégie appliquée</div>
                    <field name="quelyos_dynamic_strategy"/>
                    <div class="o_form_label mt8">N’appliquer que sur les commandes eCommerce</div>
                    <field name="quelyos_dynamic_only_website"/>

                    <div class="content-group mt16">
                        <button name="action_open_dynamic_picking_rules" type="object" string="Gérer les règles de picking" class="oe_link"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
